{
  "name": "painel-freelance",
  "version": "0.1.0",
  "private": true,
  "description": "Painel pessoal para organizar o freelance: frentes, oportunidades, tarefas e os repositórios do PC. O Claude Code gerencia pelo MCP.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "start": "vite build && node src/servidor/index.ts",
    "servidor": "node src/servidor/index.ts",
    "mcp": "node src/mcp/index.ts",
    "importar": "node src/importar.ts",
    "copiar-para-o-github": "node src/copiar-para-o-github.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
