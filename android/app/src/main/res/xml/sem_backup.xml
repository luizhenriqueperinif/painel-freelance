<?xml version="1.0" encoding="utf-8"?>
<!-- O token do GitHub e a cópia dos dados não vão para o backup do Google nem para outro aparelho. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
